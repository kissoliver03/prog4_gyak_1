<?xml version="1.0" encoding="UTF-8" ?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

    <filter>
        <filter-name>filter</filter-name>
        <filter-class>hu.pte.mik.prog4.zh1.filter.filter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>filter</filter-name>
        <url-pattern>/AddFood</url-pattern>
    </filter-mapping>


    <servlet>
        <servlet-name>Food</servlet-name>
        <servlet-class>hu.pte.mik.prog4.zh1.servlet.FoodServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>Food</servlet-name>
        <url-pattern>/Food</url-pattern>
    </servlet-mapping>

    
    <servlet>
        <servlet-name>AddFood</servlet-name>
        <servlet-class>hu.pte.mik.prog4.zh1.servlet.AddFoodServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AddFood</servlet-name>
        <url-pattern>/AddFood</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>DeleteFood</servlet-name>
        <servlet-class>hu.pte.mik.prog4.zh1.servlet.DeleteFood</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DeleteFood</servlet-name>
        <url-pattern>/DeleteFood</url-pattern>
    </servlet-mapping>

</web-app>